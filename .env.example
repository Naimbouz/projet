# Copia questo file in ".env" e inserisci i tuoi valori.
# Il file .env NON viene versionato (contiene segreti).

# Invio email reale dei promemoria tramite Brevo (https://www.brevo.com).
# Senza queste variabili, i promemoria email vengono solo SIMULATI.
BREVO_API_KEY=
MITTENTE_EMAIL=tua-email-verificata@example.com
MITTENTE_NOME=SmileFlow
